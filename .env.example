# Supabase project URL and anon key.
# Leave these blank, or keep the placeholders, to run Hissa in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public URL used in invite messages. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3847
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Used by the seed script and by admin actions that create accounts.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email of the first admin. `npm run seed` marks this profile is_admin.
# Defaults to aarav@hissa.app when unset. In demo mode Aarav is always the admin.
ADMIN_EMAIL=you@example.com

# Optional secret for the local demo session cookie.
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# Web push (optional). Generate with: npx web-push generate-vapid-keys
# Without these the app works normally and the notifications toggle is hidden.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
